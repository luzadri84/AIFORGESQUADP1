{
  "name": "Booking local",
  "dockerComposeFile": [
    "../compose.yaml",
    "../.local/transfer/compose.images.yaml",
    "compose.restored.yaml"
  ],
  "service": "dev",
  "workspaceFolder": "/workspace",
  "remoteUser": "node",
  "shutdownAction": "stopCompose",
  "overrideCommand": false,
  "initializeCommand": [
    "pwsh",
    "-NoProfile",
    "-File",
    "scripts/devcontainer-initialize.ps1"
  ],
  "postCreateCommand": "bash scripts/verify-local.sh",
  "customizations": {
    "vscode": {
      "settings": {
        "java.jdt.ls.java.home": "/opt/java/openjdk",
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
